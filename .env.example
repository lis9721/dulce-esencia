# Variables de ENTORNO DE VERCEL (producción y preview), no de desarrollo local.
#
# Para desarrollo local sigue usando backend/.env.example y
# frontend/.env.example tal como ya estaban (XAMPP, localhost, etc.) —
# este archivo no los reemplaza.
#
# Estas SÍ se configuran manualmente en el dashboard de Vercel:
# Project Settings > Environment Variables, separando "Production" de
# "Preview" (ver docs/DEPLOY.md). NUNCA se suben con valores reales a
# este repositorio, ni siquiera en un commit "temporal".

# --- Backend (servicio "backend" en vercel.json) ---

# Conexión a TiDB Serverless. El host/usuario/contraseña salen del botón
# "Connect" del clúster en TiDB Cloud (formato MySQL est\u00e1ndar).
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=essentia_db
DB_USER=tu_usuario.root
DB_PASSWORD=tu_password_de_tidb
# TiDB Cloud Starter exige TLS — dejar siempre en true en Vercel.
DB_SSL=true
# En Vercel NUNCA se sincroniza el esquema en cada cold start (ver
# backend/app/main.py) — la sincronización corre una sola vez desde
# .github/workflows/deploy.yml antes del deploy.
SKIP_SCHEMA_SYNC=true

# Genera con: python -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=genera_una_clave_propia_de_al_menos_32_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Frontend y backend quedan bajo el mismo dominio de Vercel (Services +
# rewrites, ver vercel.json): no hace falta configurar CORS_ORIGIN en
# el caso normal de un solo proyecto. Se deja documentada solo por si
# el repo terminara desplegándose como dos proyectos separados.
NODE_ENV=production
FRONTEND_URL=https://tu-proyecto.vercel.app
CORS_ORIGIN=
APP_URL=https://tu-proyecto.vercel.app

PAYMENT_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_CHECKOUT_EXPIRACION_MINUTOS=60

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Dulce Esencia Pastelería <no-responder@dulceesencia.local>

# --- Frontend (servicio "frontend" en vercel.json) ---

# Mismo dominio (rewrites internos de Vercel Services) -> ruta relativa,
# nunca una URL absoluta a otro dominio.
VITE_API_URL=/api

# --- Secretos que SOLO viven en GitHub Secrets (no en Vercel) ---
# Los usa .github/workflows/deploy.yml para hablar con la API de Vercel
# y para correr backend/scripts/sync_schema.py antes del deploy.
# No se listan aquí valores porque nunca deben existir como archivo:
#   VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
#   PROD_DB_HOST, PROD_DB_PORT, PROD_DB_NAME, PROD_DB_USER, PROD_DB_PASSWORD
