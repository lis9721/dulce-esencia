# Copia este archivo a .env y ajusta los valores según tu entorno.
# NUNCA subas el .env real (con SECRET_KEY real ni llaves de Wompi) a un repositorio público.

# --- Base de datos (MySQL/MariaDB vía XAMPP) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=essentia_db
DB_USER=root
DB_PASSWORD=
# En local (XAMPP) se dejan así. En Vercel + TiDB Cloud se cambian a
# DB_SSL=true y SKIP_SCHEMA_SYNC=true — ver /.env.example (raíz del
# repo) y docs/DEPLOY.md.
DB_SSL=false
SKIP_SCHEMA_SYNC=false

# --- Autenticación JWT ---
# Genera una clave propia, por ejemplo con:
#   python -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Servidor / CORS ---
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Solo se usa cuando NODE_ENV=production. Lista de orígenes separada por comas.
CORS_ORIGIN=
# URL pública de este backend (usada como valor por defecto de redirect-url del checkout de Wompi).
APP_URL=http://localhost:8000

# --- Módulo de pagos (Wompi Colombia) ---
# "sandbox" mientras se prueba, "production" para cobrar de verdad.
PAYMENT_ENV=sandbox
# Llaves de Sandbox (dashboard de comercios Wompi > Desarrolladores):
# tienen el prefijo pub_test_ / prv_test_. En producción usan
# pub_prod_ / prv_prod_ — ver docs/modulo-pagos-wompi.md.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
# "Secretos para integración técnica" del dashboard de Wompi — son DOS
# secretos distintos, no confundir uno con el otro.
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_CHECKOUT_EXPIRACION_MINUTOS=60

# --- Chatbot con Inteligencia Artificial (Quinto Avance) ---
# Clave de la API de OpenAI (o de un proveedor compatible). NUNCA la
# subas a GitHub ni la pongas directamente en el código — solo aquí,
# en tu .env local / variables de entorno del servidor de despliegue.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Déjalo vacío para usar OpenAI. Si usas otro proveedor compatible
# (Groq, OpenRouter, un modelo local, etc.), pon aquí su endpoint base.
OPENAI_BASE_URL=

# --- Correo saliente (SMTP) — tareas en segundo plano (BackgroundTasks) ---
# Opcional: si SMTP_HOST está vacío, los correos (verificación de cuenta,
# recuperación de contraseña, confirmación de PQR) solo se registran en
# el log del servidor y NO se envían. Con Gmail usa una "contraseña de
# aplicación", nunca tu contraseña real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Dulce Esencia Pastelería <no-responder@dulceesencia.local>
